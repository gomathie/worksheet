# Local development defaults. Do not put real credentials or tokens here.
TEAM_TZ=Africa/Accra

# Optional frontend Sentry DSN. Exposed to the browser only when intentionally configured.
VITE_SENTRY_DSN=

# Optional backend Sentry binding for Pages Functions.
SENTRY_DSN=

# Optional CI-only source-map upload settings. Never use VITE_ for the auth token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
